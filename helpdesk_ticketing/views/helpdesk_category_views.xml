<?xml version="1.0" encoding="utf-8"?>
<!--
    Views and window action for helpdesk.category master data.

    Categories are managed from Helpdesk > Configuration > Categories
    (Helpdesk Manager group only).
-->
<odoo>

    <!-- List View -->
    <record id="view_helpdesk_category_list" model="ir.ui.view">
        <field name="name">helpdesk.category.list</field>
        <field name="model">helpdesk.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_helpdesk_category_form" model="ir.ui.view">
        <field name="name">helpdesk.category.form</field>
        <field name="model">helpdesk.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Hardware, Software, Network"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description" placeholder="Describe when to use this category..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_helpdesk_category_search" model="ir.ui.view">
        <field name="name">helpdesk.category.search</field>
        <field name="model">helpdesk.category</field>
        <field name="arch" type="xml">
            <search string="Search Categories">
                <field name="name"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_helpdesk_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">helpdesk.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_helpdesk_category_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first ticket category
            </p>
            <p>
                Define categories to classify IT support requests.
            </p>
        </field>
    </record>

</odoo>
