<?xml version="1.0" encoding="utf-8"?>
<!--
    Application menus for the Helpdesk Ticketing module.

    Root menu: Helpdesk
    Submenus: Tickets, Configuration > Categories (manager only)
-->
<odoo>

    <menuitem id="menu_helpdesk_root"
              name="Helpdesk"
              sequence="50"
              groups="helpdesk_ticketing.group_helpdesk_user"/>

    <menuitem id="menu_helpdesk_tickets"
              name="Tickets"
              parent="menu_helpdesk_root"
              action="action_helpdesk_ticket"
              sequence="10"/>

    <menuitem id="menu_helpdesk_configuration"
              name="Configuration"
              parent="menu_helpdesk_root"
              sequence="100"
              groups="helpdesk_ticketing.group_helpdesk_manager"/>

    <menuitem id="menu_helpdesk_categories"
              name="Categories"
              parent="menu_helpdesk_configuration"
              action="action_helpdesk_category"
              sequence="10"/>

</odoo>
