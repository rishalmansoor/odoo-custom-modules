<?xml version="1.0" encoding="utf-8"?>
<!--
    Sequence configuration for automatic ticket number generation.

    Ticket numbers follow the pattern HT/00001, HT/00002, etc.
-->
<odoo>

    <record id="seq_helpdesk_ticket" model="ir.sequence">
        <field name="name">Helpdesk Ticket</field>
        <field name="code">helpdesk.ticket</field>
        <field name="prefix">HT/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
