<?xml version="1.0" encoding="utf-8"?>
<!--
    Security groups for the Helpdesk Ticketing module.

    - Helpdesk User: day-to-day ticket handling
    - Helpdesk Manager: full access, inherits Helpdesk User rights
-->
<odoo>

    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">Helpdesk User</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Helpdesk Manager</field>
        <field name="category_id" ref="base.module_category_services"/>
        <field name="implied_ids" eval="[(4, ref('helpdesk_ticketing.group_helpdesk_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
